# AWS DEPLOYMENT (OPTIONAL FOR LOCAL)
# Fill these to enable S3 Media Storage
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_STORAGE_BUCKET_NAME=your_s3_bucket_name
AWS_S3_REGION_NAME=us-east-1

# Fill these to enable AWS SES Email
AWS_SES_ACCESS_KEY_ID=your_ses_access_key
AWS_SES_SECRET_ACCESS_KEY=your_ses_secret_key
AWS_SES_REGION_NAME=us-east-1

# AWS Deployment Hostname (Choose one depending on service)
AWS_APP_RUNNER_HOSTNAME=your-app-name.us-east-1.awsapprunner.com
EC2_PUBLIC_IP=your_ec2_public_ip
CSRF_TRUSTED_ORIGINS=https://your-domain.com,http://your_ec2_public_ip

# DATABASE (RDS)
# For EC2/RDS, use the full postgres URL from AWS Console
DATABASE_URL=postgres://user:password@atmayantra.xxxx.us-east-1.rds.amazonaws.com:5432/dbname
